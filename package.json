{
  "name": "@startupkit-app/jobs",
  "version": "0.3.0",
  "description": "Typed, zero-dependency fetch client for Kit's (startupkit.app) public hiring API — list published jobs and submit applications from your own job site.",
  "keywords": [
    "startupkit",
    "jobs",
    "hiring",
    "ats",
    "careers",
    "job-board",
    "api-client"
  ],
  "homepage": "https://github.com/startupkit-app/jobs-js#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/startupkit-app/jobs-js.git"
  },
  "bugs": {
    "url": "https://github.com/startupkit-app/jobs-js/issues"
  },
  "license": "MIT",
  "author": "startupkit.app",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint && attw --pack .",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^2.31.1",
    "@types/node": "^20.19.43",
    "publint": "^0.3.23",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
